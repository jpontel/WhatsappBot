GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

MCP_URL=http://localhost:3001/mcp

# Apple Notes (OPCIONAL, só admin) — ponte supergateway rodando no Mac.
# Vazio = integração DESLIGADA (kill switch). Preencher só em produção, com a
# ponte no ar. NUNCA colocar o token no docker-compose.yml (repo público) —
# é injetado no container pelo env_file deste .env (gitignored).
NOTES_MCP_URL=
NOTES_MCP_TOKEN=

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./agente.db

TAVILY_API_KEY=

# Opcional: melhora o rate limit da busca de artigos (Semantic Scholar).
# Vazio funciona (pool público). OpenAlex não precisa de key.
SEMANTIC_SCHOLAR_API_KEY=
